# Workspace Next v2 環境変数テンプレート
# このファイルをコピーして .env を作成してください
# .env は絶対に Git にコミットしないこと

# Google Sheets スプレッドシートID（URLの /d/XXXX/edit の XXXX 部分）
SPREADSHEET_ID=your_spreadsheet_id_here

# Google Service Account JSON（1行に圧縮した JSON 文字列）
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Gemini API キー（Google AI Studio から取得）
GEMINI_API_KEY=your_gemini_api_key_here

# Google カレンダーID（通常は Gmailアドレス）
GOOGLE_CALENDAR_ID=your_email@gmail.com

# 追加カレンダーID（カンマ区切りで複数指定可、外部カレンダーなど）
GOOGLE_EXTRA_CALENDAR_IDS=xxxxxx@group.calendar.google.com,yyyyyy@group.calendar.google.com

# フロントエンド認証トークン（任意の安全なランダム文字列）
API_SECRET_TOKEN=your_secret_token_here
